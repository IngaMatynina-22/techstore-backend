@model TechStore.Web.ViewModels.Catalog.AttributeDefinitionFormViewModel
@{
    ViewData["Title"] = "Edit attribute";
}
<h1 class="h3 mb-3">Edit attribute</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Index" asp-route-categoryId="@Model.CategoryId">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
