@model IReadOnlyList<TechStore.Application.Features.Attributes.AttributeDefinitionDto>
@{
    ViewData["Title"] = "Attributes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Category attributes</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-categoryId="@Context.Request.Query["categoryId"]">Create attribute</a>
</div>
<partial name="_Alerts" />
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">Select category</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary" type="submit">Show</button>
    </div>
</form>
@if (Model.Count == 0)
{
    <p class="text-muted">No attributes for the selected category.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Type</th>
                <th>Unit</th>
                <th>Required</th>
                <th>Options</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td><code>@item.Code</code></td>
                <td>@item.DataType</td>
                <td>@(item.Unit ?? "—")</td>
                <td>@(item.IsRequired ? "Yes" : "No")</td>
                <td>@(item.Options.Count == 0 ? "—" : string.Join(", ", item.Options.Select(o => o.Value)))</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
}
