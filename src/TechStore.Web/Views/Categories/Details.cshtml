@model TechStore.Application.Features.Categories.CategoryDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        @if (Model.IsActive)
        {
            <a class="btn btn-outline-danger" asp-action="Deactivate" asp-route-id="@Model.Id">Deactivate</a>
        }
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Slug</dt><dd class="col-sm-9"><code>@Model.Slug</code></dd>
    <dt class="col-sm-3">Parent</dt><dd class="col-sm-9">@(Model.ParentName ?? "—")</dd>
    <dt class="col-sm-3">Sort order</dt><dd class="col-sm-9">@Model.SortOrder</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<h2 class="h5 mt-4">Children</h2>
@if (Model.Children.Count == 0)
{
    <p class="text-muted">No child categories.</p>
}
else
{
    <ul>
        @foreach (var child in Model.Children)
        {
            <li><a asp-action="Details" asp-route-id="@child.Id">@child.Name</a></li>
        }
    </ul>
}

<p class="mt-3">
    <a asp-controller="Attributes" asp-action="Index" asp-route-categoryId="@Model.Id">Manage attributes for this category</a>
</p>
