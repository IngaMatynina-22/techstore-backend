@model TechStore.Web.ViewModels.Catalog.ProductIndexViewModel
@using TechStore.Application.Features.Products
@{
    ViewData["Title"] = "Products";
    var q = Model.Query;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" asp-action="Create">Create product</a>
</div>
<partial name="_Alerts" />

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" name="Search" value="@q.Search" placeholder="Search name or SKU" />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="CategoryId" asp-items="Model.Categories">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="BrandId" asp-items="Model.Brands">
            <option value="">All brands</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="SortBy" asp-for="@q.SortBy" asp-items="Html.GetEnumSelectList<ProductSortBy>()"></select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="IsActive">
            <option value="">All statuses</option>
            <option value="true" selected="@(q.IsActive == true)">Active</option>
            <option value="false" selected="@(q.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-1">
        <button class="btn btn-outline-secondary w-100" type="submit">Filter</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Brand</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Variants</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Result.Items)
    {
        <tr class="@(item.IsActive ? "" : "table-secondary")">
            <td>@item.Name</td>
            <td>@item.CategoryName</td>
            <td>@(item.BrandName ?? "—")</td>
            <td><code>@(item.PrimarySku ?? "—")</code></td>
            <td>
                @if (item.MinSellingPrice.HasValue)
                {
                    if (item.MinSellingPrice == item.MaxSellingPrice)
                    {
                        @item.MinSellingPrice.Value.ToString("0.00")
                    }
                    else
                    {
                        @($"{item.MinSellingPrice:0.00} – {item.MaxSellingPrice:0.00}")
                    }
                }
                else
                {
                    <text>—</text>
                }
            </td>
            <td>@item.VariantsCount</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Result.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= Model.Result.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Result.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@q.Search"
                       asp-route-CategoryId="@q.CategoryId"
                       asp-route-BrandId="@q.BrandId"
                       asp-route-IsActive="@q.IsActive"
                       asp-route-SortBy="@q.SortBy"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@q.PageSize">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
<p class="text-muted small">Total: @Model.Result.TotalCount</p>
