@model TechStore.Web.ViewModels.Catalog.VariantAttributeFormViewModel
@using TechStore.Domain.Enums
@{
    ViewData["Title"] = "Variant attributes";
}
<partial name="_Alerts" />
<h1 class="h3 mb-2">Attributes for @Model.VariantName</h1>
<p class="text-muted">Product: @Model.ProductName</p>

<h2 class="h5">Current values</h2>
@if (Model.CurrentValues.Count == 0)
{
    <p class="text-muted">No values assigned yet.</p>
}
else
{
    <ul>
        @foreach (var value in Model.CurrentValues)
        {
            <li>
                <strong>@value.AttributeName</strong>:
                @(value.OptionValue ?? value.Value ?? "—")
                @if (!string.IsNullOrWhiteSpace(value.Unit))
                {
                    <text> @value.Unit</text>
                }
            </li>
        }
    </ul>
}

<h2 class="h5 mt-4">Set value</h2>
<form asp-action="VariantValues" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="VariantId" />
    <input type="hidden" asp-for="ProductName" />
    <input type="hidden" asp-for="VariantName" />
    <div class="mb-3">
        <label asp-for="AttributeId" class="form-label"></label>
        <select asp-for="AttributeId" class="form-select" asp-items="Model.AttributeOptions"></select>
        <span asp-validation-for="AttributeId" class="text-danger"></span>
    </div>
    @{
        var selected = Model.Definitions.FirstOrDefault(d => d.Id == Model.AttributeId) ?? Model.Definitions.FirstOrDefault();
    }
    @if (selected?.DataType == AttributeDataType.Select)
    {
        <div class="mb-3">
            <label asp-for="OptionId" class="form-label"></label>
            <select asp-for="OptionId" class="form-select" asp-items="@(new SelectList(selected.Options, "Id", "Value", Model.OptionId))">
                <option value="">— select —</option>
            </select>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="Value" class="form-label"></label>
            <input asp-for="Value" class="form-control" />
            <div class="form-text">Use true/false for boolean, integer for Number, decimal for Decimal.</div>
        </div>
    }
    <button type="submit" class="btn btn-primary">Save value</button>
    <a class="btn btn-link" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">Back to product</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
