@model TechStore.Web.ViewModels.Catalog.AttributeDefinitionFormViewModel
@{
    ViewData["Title"] = "Create attribute";
}
<h1 class="h3 mb-3">Create attribute</h1>
<form asp-action="Create" method="post">
    <partial name="_Form" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-link" asp-action="Index" asp-route-categoryId="@Model.CategoryId">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
