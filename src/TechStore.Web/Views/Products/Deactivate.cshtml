@model TechStore.Application.Features.Products.ProductDetailsDto
@{
    ViewData["Title"] = "Deactivate product";
}
<h1 class="h3 mb-3">Deactivate product</h1>
<p>Deactivate <strong>@Model.Name</strong>? Historical order lines keep their snapshots.</p>
<form asp-action="Deactivate" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Confirm deactivate</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
