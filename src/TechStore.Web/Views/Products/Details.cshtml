@model TechStore.Application.Features.Products.ProductDetailsDto
@{
    ViewData["Title"] = Model.Name;
}
<partial name="_Alerts" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-primary" asp-action="AddVariant" asp-route-id="@Model.Id">Add variant</a>
        @if (Model.IsActive)
        {
            <a class="btn btn-outline-danger" asp-action="Deactivate" asp-route-id="@Model.Id">Deactivate</a>
        }
    </div>
</div>
<dl class="row">
    <dt class="col-sm-3">Slug</dt><dd class="col-sm-9"><code>@Model.Slug</code></dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.CategoryName</dd>
    <dt class="col-sm-3">Brand</dt><dd class="col-sm-9">@(Model.BrandName ?? "—")</dd>
    <dt class="col-sm-3">Warranty</dt><dd class="col-sm-9">@(Model.WarrantyMonths?.ToString() ?? "—")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(Model.Description ?? Model.ShortDescription ?? "—")</dd>
</dl>

<h2 class="h5 mt-4">Variants</h2>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Name</th>
            <th>SKU</th>
            <th>Barcode</th>
            <th>Purchase</th>
            <th>Selling</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var v in Model.Variants)
    {
        <tr>
            <td>@v.VariantName</td>
            <td><code>@v.Sku</code></td>
            <td>@(v.Barcode ?? "—")</td>
            <td>@v.PurchasePrice.ToString("0.00")</td>
            <td>@v.SellingPrice.ToString("0.00")</td>
            <td>@(v.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end text-nowrap">
                <a asp-action="EditVariant" asp-route-id="@Model.Id" asp-route-variantId="@v.Id">Edit</a> |
                <a asp-controller="Attributes" asp-action="VariantValues" asp-route-productId="@Model.Id" asp-route-variantId="@v.Id">Attributes</a>
            </td>
        </tr>
    }
    </tbody>
</table>
