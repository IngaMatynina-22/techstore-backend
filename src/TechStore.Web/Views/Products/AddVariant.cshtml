@model TechStore.Web.ViewModels.Catalog.ProductVariantFormViewModel
@{
    ViewData["Title"] = "Add variant";
}
<h1 class="h3 mb-3">Add variant to @Model.ProductName</h1>
<form asp-action="AddVariant" method="post">
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ProductName" />
    <partial name="_VariantForm" />
    <button type="submit" class="btn btn-primary">Add</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.ProductId">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
