@model TechStore.Web.ViewModels.Catalog.ProductVariantFormViewModel
@{
    ViewData["Title"] = "Edit variant";
}
<h1 class="h3 mb-3">Edit variant of @Model.ProductName</h1>
<form asp-action="EditVariant" method="post">
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="VariantId" />
    <input type="hidden" asp-for="ProductName" />
    <partial name="_VariantForm" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.ProductId">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
