@model TechStore.Web.ViewModels.Catalog.ProductFormViewModel
@{
    ViewData["Title"] = "Edit product";
}
<h1 class="h3 mb-3">Edit product</h1>
<p class="text-muted">Variant prices and SKUs are edited from the product details page.</p>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_ProductForm" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
